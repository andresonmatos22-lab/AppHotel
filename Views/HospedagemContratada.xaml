<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppHotel.Views.HospedagemContratada"
             Title="Hospedagem Contratada"
             BackgroundColor="#F8FAFC">

    <VerticalStackLayout Padding="20" Spacing="16" VerticalOptions="Center">

        <Border StrokeShape="RoundRectangle 14"
                BackgroundColor="#0F172A"
                Stroke="#D97706"
                StrokeThickness="2"
                Padding="18">
            <Label Text="{Binding SuiteSelecionada.Descricao}"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="#F59E0B"
                   HorizontalOptions="Center" />
        </Border>

        <Border StrokeShape="RoundRectangle 12"
                BackgroundColor="White"
                Stroke="#CBD5E1"
                StrokeThickness="1"
                Padding="18">
            <VerticalStackLayout Spacing="12">

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <VerticalStackLayout Grid.Column="0">
                        <Label Text="Adultos:" FontSize="12" TextColor="#64748B" />
                        <Label Text="{Binding QntAdultos}" FontSize="18" FontAttributes="Bold" TextColor="#0F172A" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1">
                        <Label Text="Crianças:" FontSize="12" TextColor="#64748B" />
                        <Label Text="{Binding QntCriancas}" FontSize="18" FontAttributes="Bold" TextColor="#0F172A" />
                    </VerticalStackLayout>
                </Grid>

                <BoxView HeightRequest="1" Color="#E2E8F0" />

                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                    <VerticalStackLayout Grid.Column="0">
                        <Label Text="Check-in" FontSize="12" TextColor="#64748B" />
                        <Label Text="{Binding DataCheckIn, StringFormat='{0:dd/MM/yyyy}'}" FontAttributes="Bold" TextColor="#0F172A" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1">
                        <Label Text="Check-out" FontSize="12" TextColor="#64748B" />
                        <Label Text="{Binding DataCheckOut, StringFormat='{0:dd/MM/yyyy}'}" FontAttributes="Bold" TextColor="#0F172A" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="2">
                        <Label Text="Estadia" FontSize="12" TextColor="#64748B" />
                        <Label Text="{Binding Estadia, StringFormat='{0} dias'}" FontAttributes="Bold" TextColor="#D97706" />
                    </VerticalStackLayout>
                </Grid>

                <BoxView HeightRequest="1" Color="#E2E8F0" />

                <Label Text="VALOR TOTAL" FontSize="12" FontAttributes="Bold" TextColor="#64748B" />
                <Label Text="{Binding ValorTotal, StringFormat='{0:C2}'}" FontSize="26" FontAttributes="Bold" TextColor="#15803D" />

            </VerticalStackLayout>
        </Border>

        <Button Text="Voltar"
                BackgroundColor="#0F172A"
                TextColor="White"
                FontAttributes="Bold"
                CornerRadius="10"
                HeightRequest="46"
                Clicked="OnVoltarClicked" />

    </VerticalStackLayout>
</ContentPage>
