<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppHotel.Views.ContratacaoHospedagem"
             Title="Hotel Palace - Reservas"
             BackgroundColor="#F8FAFC">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <!-- Cabeçalho Personalizado (Azul Marinho e Dourado) -->
            <Border StrokeShape="RoundRectangle 14"
                    BackgroundColor="#0F172A"
                    Stroke="#D97706"
                    StrokeThickness="2"
                    Padding="20">
                <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                    <Label Text="HOTEL PALACE"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="#F59E0B"
                           HorizontalTextAlignment="Center" />
                    <Label Text="Cálculo de Diárias e Hospedagem"
                           FontSize="14"
                           TextColor="#E2E8F0"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- Cartão de Hóspedes (Stepper) -->
            <Border StrokeShape="RoundRectangle 12"
                    BackgroundColor="White"
                    Stroke="#CBD5E1"
                    StrokeThickness="1"
                    Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Label Text="QUANTIDADE DE HÓSPEDES"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="#D97706" />

                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12" VerticalOptions="Center">
                        <Label Grid.Column="0" Text="Adultos:" FontSize="16" TextColor="#1E293B" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding QntAdultos}" FontSize="18" FontAttributes="Bold" TextColor="#0F172A" VerticalOptions="Center" />
                        <Stepper Grid.Column="2" Minimum="1" Maximum="10" Increment="1" Value="{Binding QntAdultos}" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="#E2E8F0" />

                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12" VerticalOptions="Center">
                        <Label Grid.Column="0" Text="Crianças:" FontSize="16" TextColor="#1E293B" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding QntCriancas}" FontSize="18" FontAttributes="Bold" TextColor="#0F172A" VerticalOptions="Center" />
                        <Stepper Grid.Column="2" Minimum="0" Maximum="10" Increment="1" Value="{Binding QntCriancas}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Cartão de Suíte (Picker) -->
            <Border StrokeShape="RoundRectangle 12"
                    BackgroundColor="White"
                    Stroke="#CBD5E1"
                    StrokeThickness="1"
                    Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="ESCOLHA SUA ACOMODAÇÃO"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="#D97706" />

                    <Picker x:Name="pckSuite"
                            Title="Selecione a Suíte"
                            ItemDisplayBinding="{Binding Descricao}"
                            SelectedItem="{Binding SuiteSelecionada}"
                            TextColor="#0F172A" />
                </VerticalStackLayout>
            </Border>

            <!-- Cartão de Período (DatePicker) -->
            <Border StrokeShape="RoundRectangle 12"
                    BackgroundColor="White"
                    Stroke="#CBD5E1"
                    StrokeThickness="1"
                    Padding="16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="PERÍODO DA ESTADIA"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="#D97706" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="Check-in:" FontAttributes="Bold" TextColor="#334155" />
                            <DatePicker Date="{Binding DataCheckIn}" Format="dd/MM/yyyy" TextColor="#0F172A" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Check-out:" FontAttributes="Bold" TextColor="#334155" />
                            <DatePicker Date="{Binding DataCheckOut}" Format="dd/MM/yyyy" TextColor="#0F172A" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Botão Avançar -->
            <Button Text="Avançar para Resumo"
                    BackgroundColor="#0F172A"
                    TextColor="#F59E0B"
                    FontAttributes="Bold"
                    FontSize="16"
                    CornerRadius="10"
                    HeightRequest="50"
                    Clicked="OnAvancarClicked" />

            <!-- Botão da Nova Tela Sobre -->
            <Button Text="Sobre o Desenvolvedor"
                    BackgroundColor="#D97706"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="15"
                    CornerRadius="10"
                    HeightRequest="46"
                    Clicked="OnSobreClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
