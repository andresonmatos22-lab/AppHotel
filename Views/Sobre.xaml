<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppHotel.Views.Sobre"
             Title="Sobre"
             BackgroundColor="#F8FAFC">

    <VerticalStackLayout Padding="24" Spacing="18" VerticalOptions="Center">

        <Border StrokeShape="RoundRectangle 16"
                BackgroundColor="White"
                Stroke="#D97706"
                StrokeThickness="2"
                Padding="24">
            <VerticalStackLayout Spacing="12" HorizontalOptions="Center">

                <Image Source="dotnet_bot.png"
                       HeightRequest="90"
                       HorizontalOptions="Center" />

                <Label Text="HOTEL PALACE - APP HOTEL"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="#0F172A"
                       HorizontalTextAlignment="Center" />

                <Label Text="Aplicativo desenvolvido em .NET MAUI para a Agenda 13 (Interface Gráfica e BindingContext)."
                       FontSize="13"
                       TextColor="#475569"
                       HorizontalTextAlignment="Center" />

                <BoxView HeightRequest="1" Color="#E2E8F0" Margin="0,6" />

                <Label Text="Desenvolvedor:"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="#D97706"
                       HorizontalTextAlignment="Center" />
                <Label Text="Andreson de Jesus Matos"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="#0F172A"
                       HorizontalTextAlignment="Center" />

                <Label Text="Curso:"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="#D97706"
                       HorizontalTextAlignment="Center" />
                <Label Text="Técnico em Desenvolvimento de Sistemas - ETEC"
                       FontSize="14"
                       TextColor="#334155"
                       HorizontalTextAlignment="Center" />

                <Label Text="Ano de Desenvolvimento:"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="#D97706"
                       HorizontalTextAlignment="Center" />
                <Label Text="2026"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="#0F172A"
                       HorizontalTextAlignment="Center" />

            </VerticalStackLayout>
        </Border>

        <Button Text="Voltar"
                BackgroundColor="#0F172A"
                TextColor="#F59E0B"
                FontAttributes="Bold"
                CornerRadius="10"
                HeightRequest="46"
                Clicked="OnVoltarClicked" />

    </VerticalStackLayout>
</ContentPage>
